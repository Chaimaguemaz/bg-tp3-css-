* {
  margin: 0;
  padding: 0;
}

body {
  font-family: "Segoe UI", sans-serif;
  background-color: white;
  color: black;
  font-size: 15px;
  line-height: 1.5;
}

.container {
  background-color: red;
  width: 90%;
  margin: 0 auto;
  border: 1px solid black;
  max-width: 1100px;
}

.main-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  width: 100%;
  height: 60px;
  padding: 20px 0;
  font-size: 13px;
  background-color: white;
  border: 1px solid black;
}

.logo {
  width: 110px;
}

.main-menu {
  display: flex;
  list-style: none;
  flex: 1;
  margin-left: 20px;
}

.right-menu {
  display: flex;
  list-style: none;
}

.main-nav li {
  margin: 0 10px;
}

.main-nav a {
  color: #262626;
  text-decoration: none;
  padding-bottom: 2px;
}

.main-nav a:hover {
  border-bottom: 2px solid black;
}

.showcase {
  background-color: #CCCCCC;
  width: 100%;
  height: 60px;
  border: 1px solid black;
}

.home-cards,
.ruban,
.follow,
.links,
.sub-footer,
#bigData-intro {
  background-color: #d3eaac;
  width: 100%;
  height: 100px;
  border: 1px solid black;
}

footer {
  width: 100%;
}
