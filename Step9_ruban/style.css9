* {
  margin: 0;
  padding: 0;
}

body {
  font-family: "Segoe UI", sans-serif;
  background-color: white;
  color: black;
  font-size: 15px;
  line-height: 1.5;
}

.container {
  background-color: red;
  width: 90%;
  margin: 0 auto;
  border: 1px solid black;
  max-width: 1100px;
}

.main-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  width: 100%;
  height: 60px;
  padding: 20px 0;
  font-size: 13px;
  background-color: white;
  border: 1px solid black;
}

.logo {
  width: 110px;
}

.main-menu {
  display: flex;
  list-style: none;
  flex: 1;
  margin-left: 20px;
}

.right-menu {
  display: flex;
  list-style: none;
}

.main-nav li {
  margin: 0 10px;
}

.main-nav a {
  color: #262626;
  text-decoration: none;
  padding-bottom: 2px;
}

.main-nav a:hover {
  border-bottom: 2px solid black;
}

.showcase {
  width: 100%;
  height: 400px;
  background-color: white;
  border: none;
  background-image: url("../img/showcase.jpg");
  background-repeat: no-repeat;
  background-position: center top;
  background-size: 30%;
  background-origin: content-box;
  background-clip: content-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  padding: 50px 0;
  margin-bottom: 20px;
  box-sizing: border-box;
}

.showcase h2,
.showcase p {
  margin-bottom: 10px;
}

.showcase .btn {
  margin-top: 20px;
}

.btn {
  display: inline-block;
  padding: 10px 20px;
  background-color: #378ff5;
  color: white;
  font-weight: bold;
  border-radius: 20px;
  text-decoration: none;
}

.btn:hover {
  opacity: 0.8;
}

.dark {
  color: white;
}

.dark .btn {
  background-color: #03254c;
  color: white;
}

.home-cards {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
  margin-bottom: 40px;
  background-color: white;
  width: auto;
  height: auto;
  border: none;
}

.home-cards img {
  width: 100%;
  margin-bottom: 20px;
}

.home-cards h3 {
  margin-bottom: 5px;
}

.home-cards a {
  display: inline;
  margin-top: 10px;
  color: #0067b8;
  text-transform: uppercase;
  font-weight: bold;
  text-decoration: none;
}

.home-cards a i {
  transition: transform 0.3s;
}

.home-cards a:hover i {
  transform: translateX(10px);
}

#bigData-intro {
  width: 100%;
  height: 350px;
  background-image: url("../img/bigData.png");
  background-repeat: no-repeat;
  background-position: center;
  background-size: 100% 100%;
  margin-bottom: 20px;
  padding-bottom: 100px;
  box-sizing: border-box;
  border: none;
}

#bigData-intro .content {
  width: 40%;
  color: #262626;
  padding: 50px 0 0 30px;
}

#bigData-intro .content p {
  margin: 10px 0 20px;
}

.ruban {
  width: 100%;
  height: 350px;
  background-image: url("../img/carbon2.jpg");
  background-repeat: no-repeat;
  background-position: center -50px;
  background-size: 100% 100%;
  border: none;
}

.ruban .content {
  width: 55%;
  color: white;
  padding: 80px 0 0 30px;
}

.ruban .content p {
  margin: 10px 0 20px;
}

.follow,
.links,
.sub-footer {
  background-color: #d3eaac;
  width: 100%;
  height: 100px;
  border: 1px solid black;
}

footer {
  width: 100%;
}
