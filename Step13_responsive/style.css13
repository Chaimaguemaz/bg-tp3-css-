* {
  margin: 0;
  padding: 0;
}

body {
  font-family: "Segoe UI", sans-serif;
  background-color: white;
  color: black;
  font-size: 15px;
  line-height: 1.5;
}

.container {
  background-color: white;
  width: 90%;
  margin: 0 auto;
  border: none;
  max-width: 1100px;
}

.main-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  width: 100%;
  height: 60px;
  padding: 20px 0;
  font-size: 13px;
  background-color: white;
  border: 1px solid black;
}

.logo {
  width: 110px;
}

.main-menu {
  display: flex;
  list-style: none;
  flex: 1;
  margin-left: 20px;
}

.right-menu {
  display: flex;
  list-style: none;
}

.main-nav li {
  margin: 0 10px;
}

.main-nav a {
  color: #262626;
  text-decoration: none;
  padding-bottom: 2px;
}

.main-nav a:hover {
  border-bottom: 2px solid black;
}

.showcase {
  width: 100%;
  height: 400px;
  background-color: white;
  border: none;
  background-image: url("../img/showcase.jpg");
  background-repeat: no-repeat;
  background-position: center top;
  background-size: 30%;
  background-origin: content-box;
  background-clip: content-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  padding: 50px 0;
  margin-bottom: 20px;
  box-sizing: border-box;
}

.showcase h2,
.showcase p {
  margin-bottom: 10px;
}

.showcase .btn {
  margin-top: 20px;
}

.btn {
  display: inline-block;
  padding: 10px 20px;
  background-color: #378ff5;
  color: white;
  font-weight: bold;
  border-radius: 20px;
  text-decoration: none;
}

.btn:hover {
  opacity: 0.8;
}

.dark {
  color: white;
}

.dark .btn {
  background-color: #03254c;
  color: white;
}

.home-cards {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
  margin-bottom: 40px;
  background-color: white;
  width: auto;
  height: auto;
  border: none;
}

.home-cards img {
  width: 100%;
  margin-bottom: 20px;
}

.home-cards h3 {
  margin-bottom: 5px;
}

.home-cards a {
  display: inline;
  margin-top: 10px;
  color: #0067b8;
  text-transform: uppercase;
  font-weight: bold;
  text-decoration: none;
}

.home-cards a i {
  transition: transform 0.3s;
}

.home-cards a:hover i {
  transform: translateX(10px);
}

#bigData-intro {
  width: 100%;
  height: 350px;
  background-image: url("../img/bigData.png");
  background-repeat: no-repeat;
  background-position: center;
  background-size: 100% 100%;
  margin-bottom: 20px;
  padding-bottom: 100px;
  box-sizing: border-box;
  border: none;
}

#bigData-intro .content {
  width: 40%;
  color: #262626;
  padding: 50px 0 0 30px;
}

#bigData-intro .content p {
  margin: 10px 0 20px;
}

.ruban {
  width: 100%;
  height: 350px;
  background-image: url("../img/carbon2.jpg");
  background-repeat: no-repeat;
  background-position: center -50px;
  background-size: 100% 100%;
  border: none;
}

.ruban .content {
  width: 55%;
  color: white;
  padding: 80px 0 0 30px;
}

.ruban .content p {
  margin: 10px 0 20px;
}

.follow {
  background-color: white;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  border: none;
}

.follow > * {
  margin-right: 10px;
}

.follow span {
  color: black;
  font-size: 30px;
}

.follow a {
  color: black;
  text-decoration: none;
}

.links {
  background-color: #f2f2f2;
  color: #616161;
  padding: 35px 0;
  height: auto;
  font-size: 12px;
  border: none;
  width: 100%;
}

.links-inner {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 10px;
  margin: 0 auto;
  max-width: 1000px;
  padding: 0 20px;
  box-sizing: border-box;
}

.links li {
  list-style: none;
  line-height: 2.8;
}

.links a {
  color: #616161;
  text-decoration: none;
}

.sub-footer {
  background-color: #f2f2f2;
  color: #616161;
  font-size: 12px;
  padding: 20px 0;
  width: 100%;
  height: auto;
  border: none;
}

.footer-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  max-width: 1100px;
  margin: 0 auto;
  padding: 0 20px;
  box-sizing: border-box;
}

.footer-inner div {
  display: flex;
  align-items: center;
  margin-bottom: 20px;
}

.footer-inner div i {
  margin-right: 10px;
}

.sub-footer ul {
  display: flex;
  list-style: none;
}

.sub-footer li {
  margin-right: 30px;
  margin-bottom: 20px;
}

.sub-footer a {
  color: #616161;
  text-decoration: none;
}

footer {
  width: 100%;
  border: none;
}

/* ===== Responsive: < 700px ===== */
@media (max-width: 700px) {
  .main-nav {
    flex-direction: column;
    height: auto;
    align-items: flex-start;
  }

  .main-menu,
  .right-menu {
    flex-direction: column;
    margin-left: 0;
  }

  .home-cards {
    grid-template-columns: repeat(2, 1fr);
  }

  .showcase {
    background-size: 60%;
  }

  #bigData-intro p {
    display: none;
  }

  #bigData-intro h2 {
    margin-bottom: 20px;
  }

  .ruban .content {
    width: 85%;
  }

  .ruban {
    height: 500px;
    background-position: center top;
  }

  .links-inner {
    grid-template-columns: repeat(2, 1fr);
  }
}

/* ===== Responsive: < 500px ===== */
@media (max-width: 500px) {
  .home-cards,
  .links-inner {
    grid-template-columns: 1fr;
  }

  .links ul,
  .sub-footer ul {
    font-size: 25px;
  }

  .links li,
  .sub-footer li {
    margin-bottom: 10px;
  }

  .footer-inner {
    flex-direction: column;
    align-items: flex-start;
  }

  .sub-footer ul {
    flex-direction: column;
    align-items: flex-start;
  }
}
